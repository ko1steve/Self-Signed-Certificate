[req]
default_bits       = 2048
prompt             = no
default_md         = sha256
req_extensions     = req_ext
distinguished_name = dn

[dn]
C  = TW
ST = Taipei
L  = Taipei
O  = MyOrg
OU = MyUnit
CN = Hostname

[req_ext]
subjectAltName = @alt_names

[alt_names]
DNS.1 = Hostname
IP.1  = 192.168.123.123